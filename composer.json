{
  "name": "local/lebenslauf-vorlage",
  "description": "Shared-hosting-friendly CV site (PHP + Twig) with file-based state.",
  "type": "project",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/blaumohn/pipeline-config-spec-php"
    }
  ],
  "require": {
    "php": "^8.2",
    "pipeline-config-spec/lib": "dev-main@dev",
    "opis/json-schema": "^2.4",
    "slim/slim": "^4.12",
    "slim/psr7": "^1.6",
    "twig/twig": "^3.0",
    "phpmailer/phpmailer": "^6.9",
    "symfony/console": "^7.0",
    "symfony/config": "^7.0",
    "symfony/yaml": "^7.0",
    "symfony/process": "^7.0",
    "symfony/filesystem": "^7.0",
    "symfony/lock": "^7.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.13",
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Content\\": "src/content/",
      "App\\Http\\": "src/Http/",
      "App\\Cli\\": "src/cli/php/",
      "App\\Cli\\Shared\\": "src/cli/php/shared/"
    }
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    }
  },
  "scripts": {
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "php bin/cli python dev src/cli/py/dev/dev.py --"
    ],
    "dev:build": [
      "Composer\\Config::disableProcessTimeout",
      "php bin/cli python dev src/cli/py/dev/dev.py -- --build"
    ],
    "cv:build": "php bin/cli build dev cv",
    "cv:upload": "php bin/cli build dev upload",
    "token:rotate": "php bin/cli token rotate",
    "captcha:cleanup": "php bin/cli captcha dev",
    "config:get": "php bin/cli config get dev",
    "config:compile": "php bin/cli config compile dev",
    "config:lint": "php bin/cli config lint dev",
    "config:show": "php bin/cli config show dev",
    "lint": [
      "@lint:php",
      "@lint:python",
      "@lint:shell"
    ],
    "lint:php": [
      "@lint:phpcs",
      "@lint:phpstan"
    ],
    "lint:phpcs": "phpcs",
    "lint:phpstan": "phpstan analyse --debug --memory-limit=512M",
    "lint:python": "php bin/cli python dev tools/lint-python.py --",
    "lint:shell": "shellcheck bin/cd bin/ci scripts/*.sh tests/ci/*.sh",
    "test": "phpunit",
    "css:build": "npm run build:css",
    "build": "php bin/cli build dev",
    "build:dev": "php bin/cli build dev",
    "build:preview": "php bin/cli build preview",
    "setup": "php bin/cli setup dev",
    "setup:dev": "php bin/cli setup dev",
    "setup:preview": "php bin/cli setup preview",
    "ci:dev": [
      "Composer\\Config::disableProcessTimeout",
      "docker compose -f docker-compose.ci.yml up --remove-orphans --build ci-dev"
    ],
    "ci:preview": [
      "Composer\\Config::disableProcessTimeout",
      "php bin/cli python dev tools/run-ci-preview.py --"
    ],
    "ci:preview:debug": [
      "Composer\\Config::disableProcessTimeout",
      "DEBUG=1 php bin/cli python dev tools/run-ci-preview.py --"
    ],
    "deploy:preview": [
      "php bin/cli build preview"
    ]
  }
}
