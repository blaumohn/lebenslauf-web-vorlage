#!/bin/sh
# shellcheck shell=sh
# Pre-Push-Hook: fuehrt die lokale CI-Testmatrix vor dem Push aus.
# Einrichtung: sh scripts/install-hooks.sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)

cd "$REPO_ROOT"
composer run ci:dev
composer run ci:preview
