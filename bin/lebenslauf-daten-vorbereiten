set -euo pipefail
set -E
trap 'echo "[lebenslauf-daten-vorbereiten] Fehler in Zeile $LINENO: $BASH_COMMAND" >&2' ERR

if [[ "${DEBUG:-0}" == "1" ]]; then
  set -x
fi

SOURCE_REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$SOURCE_REPO_DIR/scripts/shell_env.sh"
. "$SOURCE_REPO_DIR/scripts/ci_clone_lib.sh"

require_nonempty PIPELINE CI_WORK_BASE

[ "$PIPELINE" != dev ] && require_nonempty PIPELINE_RUN_ID

CV_DATA_PATH_CREATED=0

main() {
  WORK_REPO_DIR="$(prepare_repo_dir)"
  cd "$WORK_REPO_DIR"
  export PATH="$WORK_REPO_DIR/bin:$PATH"
  . scripts/pipeline_lib.sh

  write_pipeline_config_from_stdin

  run_step "Abhängigkeiten installieren" composer install:ci
  run_step "Setup ($PIPELINE)"           cli setup "$PIPELINE"
  run_step "Lebenslauf-Datenpfad"        ensure_cv_data_path
  upload_cv_data_if_needed
}

ensure_cv_data_path() {
  local data_path
  data_path="$(cli config "$PIPELINE" get LEBENSLAUF_DATEN_PFAD --phase build)"
  if [[ -d "$data_path" ]]; then
    CV_DATA_PATH_CREATED=0
    return 0
  fi

  mkdir -p "$data_path"
  cp src/resources/fixtures/lebenslauf/daten-*.yaml "$data_path"/
  CV_DATA_PATH_CREATED=1
}

upload_cv_data_if_needed() {
  [[ "$CV_DATA_PATH_CREATED" == "1" ]] || return 0
  run_step "Lebenslauf hochladen" vorbereiten_lebenslauf
}

vorbereiten_lebenslauf() {
  cli python "$PIPELINE" --phase build --phase deploy -- \
    scripts/lebenslauf-sftp-upload.py
}

main "$@"
