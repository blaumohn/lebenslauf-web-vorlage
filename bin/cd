#!/usr/bin/env bash
set -euo pipefail

if [[ "${DEBUG:-0}" == "1" ]]; then
  set -x
fi

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$REPO_DIR/scripts/shell_env.sh"

require_env_nonempty PIPELINE

COMPOSER_INSTALL_ARGS=(--optimize-autoloader --no-interaction)

main() {
  cd "$REPO_DIR"
  export PATH="$REPO_DIR/bin:$PATH"
  . scripts/pipeline_lib.sh

  local mode="${1:-deploy}"
  if [[ $# -gt 1 ]]; then
    echo "bin/cd erwartet höchstens einen Modus" >&2
    exit 1
  fi

  if [[ "$mode" == "sftp-write-smoke" ]]; then
    run_sftp_write_smoke
    return
  fi

  if [[ "$mode" != "deploy" ]]; then
    echo "Unbekannter bin/cd-Modus: $mode" >&2
    exit 1
  fi

  run_cd_deploy
}

run_cd_deploy() {
  if [[ $# -gt 0 ]]; then
    echo "bin/cd verwendet keine Argumente" >&2
    exit 1
  fi
  require_env_set LAST_DEPLOY_COMMIT

  if no_changes_since_deploy; then
    exit 0
  fi

  composer install "${COMPOSER_INSTALL_ARGS[@]}" --no-dev

  DEPLOY_DIR="var/deploy"
  run_pipeline
}

run_sftp_write_smoke() {
  write_pipeline_config_from_stdin
  composer install "${COMPOSER_INSTALL_ARGS[@]}" --no-dev
  cli setup "$PIPELINE"
  cli python "$PIPELINE" --phases deploy scripts/sftp-write-smoke.py
}

main "$@"
