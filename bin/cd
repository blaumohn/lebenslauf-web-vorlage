#!/usr/bin/env bash
set -euo pipefail
set -E

if [[ "${DEBUG:-0}" == "1" ]]; then
  set -x
fi

if [[ $# -gt 0 ]]; then
  echo "bin/cd verwendet keine Argumente" >&2
  exit 1
fi

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$REPO_DIR/scripts/shell_env.sh"

cd "$REPO_DIR"
export PATH="$REPO_DIR/bin:$PATH"
. scripts/pipeline_lib.sh

main() {
  local deploy_dir
  require_nonempty PIPELINE LAST_DEPLOY_COMMIT

  write_pipeline_config_from_stdin

  if no_changes_since_deploy "$LAST_DEPLOY_COMMIT"; then
    ci_note "Kein Deploy: keine Änderungen seit LAST_DEPLOY_COMMIT=${LAST_DEPLOY_COMMIT}"
    exit 0
  fi

  run_step "Abhängigkeiten installieren" composer install:deploy

  deploy_dir="var/deploy"
  run_pipeline "$deploy_dir"
}

main "$@"
