#!/usr/bin/env bash
set -euo pipefail

if [[ "${DEBUG:-0}" == "1" ]]; then
  set -x
fi

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$ROOT_DIR/bin:$PATH"
COMPOSER_INSTALL_ARGS=(--optimize-autoloader --no-interaction)
DEPLOY_DIR="$ROOT_DIR/var/deploy"

. "$ROOT_DIR/scripts/pipeline_lib.sh"

main() {
  if [[ $# -gt 0 ]]; then
    echo "bin/cd verwendet keine Argumente" >&2
    exit 1
  fi

  local pipeline="${APP_PIPELINE:?APP_PIPELINE nicht gesetzt}"

  if [[ -n "${DEPLOY_BEFORE:-}" ]] && git diff --quiet "$DEPLOY_BEFORE" HEAD; then
    exit 0
  fi

  pip install --quiet paramiko
  composer install "${COMPOSER_INSTALL_ARGS[@]}" --no-dev
  run_pipeline "$pipeline"
}

main "$@"
