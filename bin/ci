#!/usr/bin/env bash
set -euo pipefail

if [[ "${DEBUG:-0}" == "1" ]]; then
  set -x
fi

ROOT_DIR_RO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$ROOT_DIR_RO/scripts/shell_env.sh"

require_env_nonempty APP_PIPELINE

COMPOSER_INSTALL_ARGS=(--optimize-autoloader --no-interaction)

main() {
  local test_case="${1:-}" pipeline work_dir
  pipeline="$APP_PIPELINE"

  ROOT_DIR="$(clone_work_dir)"
  apply_working_state
  export PATH="$ROOT_DIR/bin:$PATH"
  cd "$ROOT_DIR"
  . "$ROOT_DIR/scripts/pipeline_lib.sh"

  if [[ "$pipeline" == "preview" ]]; then
    DEPLOY_DIR="$ROOT_DIR/var/deploy"
    setup_preview_ci_env

    case "$test_case" in
      test-admin-deploy)          export LAST_DEPLOY_COMMIT="" ;;
      test-push-deploy)           setup_push_deploy_test ;;
      test-composer-lock-changed) setup_composer_lock_test ;;
      *)  echo "bin/ci: unbekannter Testfall: $test_case" >&2; exit 1 ;;
    esac
  fi

  composer install "${COMPOSER_INSTALL_ARGS[@]}"
  [[ -n "${CI_BUILD_ID:-}" ]] && printf '%s' "$CI_BUILD_ID" > vendor/.ci-build-id
  run_pipeline "$pipeline"

  if [[ "$pipeline" == "preview" ]]; then
    if [[ "$test_case" == "test-push-deploy" ]]; then
      smoke_http_page_contains "preview-web" "80" "/ci-diff-test.html" "ci-diff-test"
      check_vendor_not_uploaded "$pipeline"
    fi
    if [[ "$test_case" == "test-composer-lock-changed" ]]; then
      check_vendor_uploaded "$pipeline"
    fi
    http_smoke_checks "preview-web" "80"
  fi
}

test_no_diff_deploy() {
  no_changes_since_deploy \
    || { echo "[no-diff-check] Deploy-Skip bei leerem Diff fehlgeschlagen" >&2; return 1; }
}

setup_push_deploy_test() {
  export LAST_DEPLOY_COMMIT="$(git rev-parse HEAD)"
  test_no_diff_deploy
  printf '<!-- ci-diff-test -->\n' > public/ci-diff-test.html
  git add public/ci-diff-test.html
  git -c user.name="CI Test" -c user.email="ci@test.invalid" \
    commit -m "test: diff-deploy ci-test"
  export CI_BUILD_ID="$(git rev-parse HEAD)"
}

setup_composer_lock_test() {
  export LAST_DEPLOY_COMMIT="$(git rev-parse HEAD)"
  printf '\n' >> composer.lock
  git add composer.lock
  git -c user.name="CI Test" -c user.email="ci@test.invalid" \
    commit -m "test: diff-deploy composer-lock-changed ci-test"
  export CI_BUILD_ID="$(git rev-parse HEAD)"
}

sftp_read_vendor_build_id() {
  local pipeline="$1" overrides cfg_json
  overrides="$(php scripts/build-overrides-json.php)"
  cfg_json="$(cli config get "$pipeline" --phase deploy --overrides "$overrides")"
  SFTP_CFG_JSON="$cfg_json" python3 "$ROOT_DIR/scripts/sftp-read-vendor-build-id.py"
}

check_vendor_not_uploaded() {
  local pipeline="$1" server_id
  server_id="$(sftp_read_vendor_build_id "$pipeline")"
  if [[ "$server_id" == "$CI_BUILD_ID" ]]; then
    echo "[vendor-check] vendor/ fälschlicherweise hochgeladen: build_id=$CI_BUILD_ID" >&2
    return 1
  fi
}

check_vendor_uploaded() {
  local pipeline="$1" server_id
  server_id="$(sftp_read_vendor_build_id "$pipeline")"
  if [[ "$server_id" != "$CI_BUILD_ID" ]]; then
    echo "[vendor-check] vendor/ nicht hochgeladen: erwartet=$CI_BUILD_ID, server=$server_id" >&2
    return 1
  fi
}

clone_work_dir() {
  local work_dir
  work_dir="$(mktemp -d "${CI_WORK_BASE:-/tmp}/ci-XXXXXX")"
  git clone --local --no-hardlinks /repo "$work_dir"
  echo "$work_dir"
}

apply_working_state() {
  local diff
  diff="$(git -C /repo -c safe.directory=/repo diff --binary HEAD)"
  [ -n "$diff" ] && echo "$diff" | git -C "$ROOT_DIR" apply --whitespace=nowarn
  git -C /repo -c safe.directory=/repo ls-files --others --exclude-standard \
    | while IFS= read -r f; do
        mkdir -p "$ROOT_DIR/$(dirname "$f")"
        cp "/repo/$f" "$ROOT_DIR/$f"
      done
}

setup_preview_ci_env() {
  export FTP_HOST="sftp-server"
  export FTP_USER="preview-ci"
  export FTP_PASS="ci-pass"
  export FTP_PORT="22"
  export FTP_SERVER_DIR="/public"
  export SSH_KNOWN_HOST_LINE="$(await_sftp_host_key sftp-server 22)"
}

await_sftp_host_key() {
  local host="$1" port="$2" keys attempt

  for attempt in $(seq 1 10); do
    keys="$(ssh-keyscan -p "$port" "$host" 2>/dev/null | grep -v '^#')"
    [[ -n "$keys" ]] && echo "$keys" && return
    sleep 1
  done
  echo "SFTP-Hostschlüssel von ${host}:${port} nicht erreichbar" >&2
  exit 1
}

main "$@"
