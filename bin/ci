#!/usr/bin/env bash
set -euo pipefail

if [[ "${DEBUG:-0}" == "1" ]]; then
  set -x
fi

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$ROOT_DIR/bin:$PATH"
COMPOSER_INSTALL_ARGS=(--optimize-autoloader --no-interaction)
DEPLOY_DIR="$ROOT_DIR/var/deploy"
GITHUB_OUTPUT="${GITHUB_OUTPUT:-}"

. "$ROOT_DIR/scripts/pipeline_lib.sh"

main() {
  if [[ $# -gt 0 ]]; then
    echo "bin/ci verwendet keine Argumente" >&2
    exit 1
  fi
  local pipeline="${APP_PIPELINE:?APP_PIPELINE nicht gesetzt}"

  prepare_work_dir

  if [[ "$pipeline" == "preview" ]]; then
    seed_preview_fixture_env
    GITHUB_OUTPUT="$(mktemp)"
  fi

  composer install "${COMPOSER_INSTALL_ARGS[@]}"
  run_pipeline "$pipeline"
}

prepare_work_dir() {
  local work_dir diff

  work_dir="$(mktemp -d "${CI_WORK_BASE:-/tmp}/ci-XXXXXX")"
  git clone --local --no-hardlinks /src "$work_dir"
  diff="$(git -C /src -c safe.directory=/src diff --binary HEAD)"
  [ -n "$diff" ] && echo "$diff" | git -C "$work_dir" apply --whitespace=nowarn
  git -C /src -c safe.directory=/src ls-files --others --exclude-standard \
    | while IFS= read -r f; do
        case "$f" in
          .local/*|.venv/*|node_modules/*|public/*|var/cache/*|vendor/*) continue ;;
        esac
        mkdir -p "$work_dir/$(dirname "$f")"
        cp "/src/$f" "$work_dir/$f"
      done
  ROOT_DIR="$work_dir"
  DEPLOY_DIR="$work_dir/var/deploy"
  export PATH="$ROOT_DIR/bin:$PATH"
  cd "$work_dir"
}

seed_preview_fixture_env() {
  SMTP_PASS="preview-secret"
  FTP_HOST="preview.example.test"
  FTP_USER="preview-user"
  FTP_PASS="preview-pass"
  FTP_PORT="21"
  FTP_SERVER_DIR="/home/preview/public"
}

main "$@"
