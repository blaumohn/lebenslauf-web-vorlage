#!/usr/bin/env bash
set -euo pipefail

if [[ "${DEBUG:-0}" == "1" ]]; then
  set -x
fi

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMMAND="${1:-}"
PIPELINE="${2:-}"
FORMAT="env"
DEPLOY_DIR="$ROOT_DIR/var/deploy"

usage() {
  echo "Usage: ci <command> <pipeline> [options]"
  echo "Commands: config-check, deploy-check, prepare-config, resolve-deploy"
}

require_args() {
  if [[ "$COMMAND" != "" && "$PIPELINE" != "" ]]; then
    return 0
  fi
  usage
  exit 1
}

ensure_preview_pipeline() {
  local pipeline="$1"
  if [[ "$pipeline" == "preview" ]]; then
    return 0
  fi
  echo "Unbekannte Pipeline fuer $COMMAND: $pipeline" >&2
  exit 1
}

require_env() {
  local key="$1"
  local value="${!key:-}"
  if [[ "$value" != "" ]]; then
    return 0
  fi
  echo "Erwartet gesetzte Umgebungsvariable: $key" >&2
  exit 1
}

yaml_quote() {
  local value="$1"
  value="${value//\'/\'\'}"
  printf "'%s'" "$value"
}

write_preview_runtime_config() {
  local pipeline="$1"
  local target="$ROOT_DIR/.local/${pipeline}-runtime.yaml"
  require_env SMTP_PASS
  mkdir -p "$ROOT_DIR/.local"
  {
    echo "runtime:"
    echo "  SMTP_PASS: $(yaml_quote "${SMTP_PASS}")"
  } > "$target"
}

write_preview_deploy_config() {
  local pipeline="$1"
  local target="$ROOT_DIR/.local/${pipeline}-deploy.yaml"
  require_env FTP_SERVER_DIR
  require_env FTP_PORT
  require_env FTP_HOST
  require_env FTP_USER
  require_env FTP_PASS
  mkdir -p "$ROOT_DIR/.local"
  {
    echo "deploy:"
    echo "  FTP_SERVER_DIR: $(yaml_quote "${FTP_SERVER_DIR}")"
    echo "  FTP_PORT: $(yaml_quote "${FTP_PORT}")"
    echo "  FTP_HOST: $(yaml_quote "${FTP_HOST}")"
    echo "  FTP_USER: $(yaml_quote "${FTP_USER}")"
    echo "  FTP_PASS: $(yaml_quote "${FTP_PASS}")"
  } > "$target"
}

run_prepare_config() {
  local pipeline="$1"
  ensure_preview_pipeline "$pipeline"
  write_preview_runtime_config "$pipeline"
  write_preview_deploy_config "$pipeline"
}

parse_extra_args() {
  shift 2

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --format)
        if [[ $# -lt 2 ]]; then
          echo "Wert fuer --format fehlt" >&2
          exit 1
        fi
        FORMAT="$2"
        shift 2
        ;;
      --dir)
        if [[ $# -lt 2 ]]; then
          echo "Wert fuer --dir fehlt" >&2
          exit 1
        fi
        DEPLOY_DIR="$2"
        shift 2
        ;;
      *)
        echo "Unbekanntes Argument: $1" >&2
        exit 1
        ;;
    esac
  done
}

run_config_get() {
  local phase="$1"
  local key="$2"

  case "$phase" in
    build)
      env -u SMTP_PASS -u FTP_HOST -u FTP_USER -u FTP_PASS -u FTP_PORT -u FTP_SERVER_DIR \
        php "$ROOT_DIR/bin/cli" config get "$PIPELINE" "$key" --phase "$phase"
      ;;
    runtime)
      env -u FTP_HOST -u FTP_USER -u FTP_PASS -u FTP_PORT -u FTP_SERVER_DIR \
        php "$ROOT_DIR/bin/cli" config get "$PIPELINE" "$key" --phase "$phase"
      ;;
    deploy)
      env -u SMTP_PASS \
        php "$ROOT_DIR/bin/cli" config get "$PIPELINE" "$key" --phase "$phase"
      ;;
  esac
}

run_config_check() {
  local pipeline="$1"
  ensure_preview_pipeline "$pipeline"

  local profile
  profile="$(run_config_get build LEBENSLAUF_PUBLIC_PROFILE)"
  if [[ "$profile" != "default" ]]; then
    echo "Erwartet LEBENSLAUF_PUBLIC_PROFILE=default, erhalten: $profile" >&2
    exit 1
  fi

  local mail_stdout
  mail_stdout="$(run_config_get runtime MAIL_STDOUT)"
  if [[ "$mail_stdout" != "1" ]]; then
    echo "Erwartet MAIL_STDOUT=1, erhalten: $mail_stdout" >&2
    exit 1
  fi

  local ftp_port
  ftp_port="$(run_config_get deploy FTP_PORT)"
  if [[ "$ftp_port" != "21" ]]; then
    echo "Erwartet FTP_PORT=21, erhalten: $ftp_port" >&2
    exit 1
  fi

  local ftp_server_dir
  ftp_server_dir="$(run_config_get deploy FTP_SERVER_DIR)"
  if [[ "$ftp_server_dir" == "" ]]; then
    echo "Erwartet gesetztes FTP_SERVER_DIR" >&2
    exit 1
  fi
}

print_resolved_value() {
  local name="$1"
  local key="$2"
  local value
  value="$(run_config_get deploy "$key")"
  printf '%s=%s\n' "$name" "$value"
}

run_resolve_deploy() {
  local pipeline="$1"
  ensure_preview_pipeline "$pipeline"

  case "$FORMAT" in
    env|github-output)
      print_resolved_value ftp_host FTP_HOST
      print_resolved_value ftp_user FTP_USER
      print_resolved_value ftp_pass FTP_PASS
      print_resolved_value ftp_port FTP_PORT
      print_resolved_value ftp_server_dir FTP_SERVER_DIR
      ;;
    *)
      echo "Unbekanntes Ausgabeformat: $FORMAT" >&2
      exit 1
      ;;
  esac
}

prepare_deploy_dir() {
  rm -rf "$DEPLOY_DIR"
  mkdir -p "$DEPLOY_DIR/var/cache"
  mkdir -p "$DEPLOY_DIR/src"
  cp -a public vendor "$DEPLOY_DIR/"
  cp -a src/http src/resources "$DEPLOY_DIR/src/"
  cp -a var/cache/html "$DEPLOY_DIR/var/cache/"
  copy_deploy_htaccess root "$DEPLOY_DIR/.htaccess"
  copy_deploy_htaccess src "$DEPLOY_DIR/src/.htaccess"
  copy_deploy_htaccess var "$DEPLOY_DIR/var/.htaccess"
}

copy_deploy_htaccess() {
  local scope="$1"
  local target="$2"
  local source="$ROOT_DIR/src/resources/http/$scope/.htaccess"

  cp "$source" "$target"
}

verify_artifact() {
  test -f "$DEPLOY_DIR/public/index.php"
  test -f "$DEPLOY_DIR/var/cache/html/cv-public.html"
  test -f "$DEPLOY_DIR/.htaccess"
  test -f "$DEPLOY_DIR/src/.htaccess"
  test -f "$DEPLOY_DIR/var/.htaccess"
}

smoke_http() {
  php -S 127.0.0.1:8081 -t "$ROOT_DIR/public" > /tmp/preview-http.log 2>&1 &
  local server_pid=$!
  trap 'kill $server_pid' EXIT
  sleep 1
  curl --fail --silent --show-error http://127.0.0.1:8081/ > /tmp/preview-home.html
  curl --fail --silent --show-error http://127.0.0.1:8081/cv > /tmp/preview-cv.html
  curl --fail --silent --show-error http://127.0.0.1:8081/contact > /tmp/preview-contact.html
}

run_deploy_check() {
  local pipeline="$1"
  ensure_preview_pipeline "$pipeline"
  prepare_deploy_dir
  verify_artifact
  smoke_http
}

main() {
  require_args
  parse_extra_args "$@"
  case "$COMMAND" in
    config-check)
      run_config_check "$PIPELINE"
      ;;
    deploy-check)
      run_deploy_check "$PIPELINE"
      ;;
    prepare-config)
      run_prepare_config "$PIPELINE"
      ;;
    resolve-deploy)
      run_resolve_deploy "$PIPELINE" "${3:-}"
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
