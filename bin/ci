set -euo pipefail
set -E
trap 'echo "[ci] Fehler in Zeile $LINENO: $BASH_COMMAND" >&2' ERR

if [[ "${DEBUG:-0}" == "1" ]]; then
  set -x
fi

SOURCE_REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$SOURCE_REPO_DIR/scripts/shell_env.sh"

require_env_nonempty PIPELINE CI_WORK_BASE

[ "$PIPELINE" != dev ] && require_env_nonempty PIPELINE_RUN_ID

main() {
  local test_case="${1:-}"

  WORK_REPO_DIR="$(clone_work_dir)"
  cd "$WORK_REPO_DIR"
  apply_working_state
  commit_working_state
  export PATH="$WORK_REPO_DIR/bin:$PATH"

  . scripts/pipeline_lib.sh

  if [[ "$PIPELINE" != "dev" ]]; then
    LAST_DEPLOY_COMMIT="$(setup_deploy_test_case "$test_case")"
    DEPLOY_DIR="var/deploy"
  fi

  run_step "Abhängigkeiten installieren" composer install:ci
  run_pipeline
  run_post_deploy_checks "$test_case"
}

setup_deploy_test_case() {
  local test_case="$1"
  case "$test_case" in
    test-admin-deploy)          ;;
    test-push-deploy)           setup_push_deploy_test ;;
    test-composer-lock-changed) setup_composer_lock_test ;;
    test-rollback)              setup_rollback_test ;;
    *)  echo "bin/ci: unbekannter Testfall: $test_case" >&2; exit 1 ;;
  esac
}

run_post_deploy_checks() {
  local test_case="$1"
  if [[ "$PIPELINE" != "preview" ]]; then
    return
  fi
  run_preview_test_case_checks "$test_case"
  [[ "$test_case" == "test-rollback" ]] && return
  run_step "SMTP-Smoke"    run_smtp_smoke
  run_step "Contact-Smoke" run_contact_smoke
  run_step "Token-Smoke"   run_token_smoke
}

read_deploy_history() {
  cli python "$PIPELINE" --phase deploy scripts/sftp-read-deploy-history.py
}

run_preview_test_case_checks() {
  local test_case="$1" history
  case "$test_case" in
    test-push-deploy)
      history="$(read_deploy_history)"
      run_push_deploy_preview_checks "$history"
      ;;
    test-composer-lock-changed)
      history="$(read_deploy_history)"
      run_composer_lock_preview_checks "$history"
      ;;
    test-rollback)
      run_rollback_preview_checks
      ;;
  esac
}

run_push_deploy_preview_checks() {
  local history="$1" root_url
  root_url="$(cli config "$PIPELINE" get APP_ROOT_URL --phase deploy)"
  smoke_http_page_contains "${root_url%/}/ci-diff-test.html" "ci-diff-test"
  check_vendor_not_reuploaded "$history"
}

run_composer_lock_preview_checks() {
  local history="$1"
  check_vendor_reuploaded "$history"
}

run_smtp_smoke() {
  cli python "$PIPELINE" --phase runtime tests/ci/smtp-smoke.py
}

run_contact_smoke() {
  cli python "$PIPELINE" --phase deploy --phase runtime tests/ci/contact_smoke.py
}

run_token_smoke() {
  local root_url token
  root_url="$(cli config "$PIPELINE" get APP_ROOT_URL --phase deploy)"
  token="$(cli token "$PIPELINE" rotate gueltig)"
  smoke_http_page_contains \
    "${root_url%/}/cv?token=${token}&profile=gueltig" \
    "</html>"
}

test_no_diff_deploy() {
  local last_deploy_commit="$1"
  git diff --quiet "$last_deploy_commit" HEAD \
    || { echo "[no-diff-check] Deploy-Skip bei leerem Diff fehlgeschlagen" >&2; return 1; }
}

setup_rollback_test() {
  local last_deploy_commit
  last_deploy_commit="$(git rev-parse HEAD)"
  printf 'rollback-sentinel\n' > public/rollback-sentinel.html
  git add public/rollback-sentinel.html
  git -c user.name="CI Test" -c user.email="ci@test.invalid" \
    commit -m "test: rollback-sentinel ci-test" >&2
  printf '%s\n' "$last_deploy_commit"
}

run_rollback_preview_checks() {
  local root_url url
  root_url="$(cli config "$PIPELINE" get APP_ROOT_URL --phase deploy)"
  url="${root_url%/}/rollback-sentinel.html"
  if curl --fail --silent --show-error "$url" > /dev/null 2>&1; then
    echo "[rollback-check] Fehler: Sentinel erreichbar — Rollback nicht erfolgt" >&2
    return 1
  fi
}

setup_push_deploy_test() {
  local last_deploy_commit
  last_deploy_commit="$(git rev-parse HEAD)"
  test_no_diff_deploy "$last_deploy_commit"
  printf '<!-- ci-diff-test -->\n' > public/ci-diff-test.html
  git add public/ci-diff-test.html
  git -c user.name="CI Test" -c user.email="ci@test.invalid" \
    commit -m "test: diff-deploy ci-test" >&2
  printf '%s\n' "$last_deploy_commit"
}

setup_composer_lock_test() {
  local last_deploy_commit
  last_deploy_commit="$(git rev-parse HEAD)"
  mutate_composer_lock_for_vendor_test
  git add composer.lock
  git -c user.name="CI Test" -c user.email="ci@test.invalid" \
    commit -m "test: diff-deploy composer-lock-changed ci-test" >&2
  printf '%s\n' "$last_deploy_commit"
}

mutate_composer_lock_for_vendor_test() {
  php -r '
$path = "composer.lock";
$data = json_decode(file_get_contents($path), true, 512, JSON_THROW_ON_ERROR);
$data["_ci_vendor_checksum_probe"] = "1";
$json = json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
file_put_contents($path, $json . PHP_EOL);
'
}

json_get() {
  local field="$1"
  jq -r --arg field "$field" '.[$field] // ""'
}

history_field() {
  local history="$1" field="$2"
  printf '%s\n' "$history" | json_get "$field"
}

check_vendor_not_reuploaded() {
  local history="$1" before after
  before="$(history_field "$history" vendor_before)"
  after="$(history_field "$history" vendor_after)"
  [[ "$before" == "$after" ]] \
    || { echo "[vendor-check] Fehler: Vendor wurde neu hochgeladen — erwartet kein Wechsel, tatsächlich: ${before} → ${after}" >&2; return 1; }
}

check_vendor_reuploaded() {
  local history="$1" before after
  before="$(history_field "$history" vendor_before)"
  after="$(history_field "$history" vendor_after)"
  [[ "$before" != "$after" ]] \
    || { echo "[vendor-check] Fehler: Vendor nicht neu hochgeladen — erwartet Wechsel von ${before}, tatsächlich kein Wechsel" >&2; return 1; }
}

clone_work_dir() {
  local work_dir
  work_dir="$(mktemp -d "$CI_WORK_BASE/ci-XXXXXX")"
  git clone --local --no-hardlinks "$SOURCE_REPO_DIR" "$work_dir"
  echo "$work_dir"
}

apply_working_state() {
  apply_tracked_working_diff
  copy_untracked_working_files
}

commit_working_state() {
  [[ -z "$(git status --porcelain)" ]] && return 0
  git add -A
  git -c user.name="CI Test" -c user.email="ci@test.invalid" \
    commit -m "tmp: lokaler Arbeitsstand"
}

apply_tracked_working_diff() {
  local diff
  diff="$(git -C "$SOURCE_REPO_DIR" -c safe.directory="$SOURCE_REPO_DIR" diff --binary HEAD)"
  if [[ -z "$diff" ]]; then
    return 0
  fi
  echo "$diff" | git apply --whitespace=nowarn
}

copy_untracked_working_files() {
  git -C "$SOURCE_REPO_DIR" -c safe.directory="$SOURCE_REPO_DIR" ls-files --others --exclude-standard \
    | while IFS= read -r f; do
        copy_untracked_working_file "$f"
      done
}

copy_untracked_working_file() {
  local file="$1"
  mkdir -p "$(dirname "$file")"
  cp "$SOURCE_REPO_DIR/$file" "$file"
}

main "$@"
