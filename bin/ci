set -euo pipefail

if [[ "${DEBUG:-0}" == "1" ]]; then
  set -x
fi

SOURCE_REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$SOURCE_REPO_DIR/scripts/shell_env.sh"

require_env_nonempty PIPELINE CI_WORK_BASE

COMPOSER_INSTALL_ARGS=(--optimize-autoloader --no-interaction)

main() {
  local test_case="${1:-}"
  local ci_build_id=""

  WORK_REPO_DIR="$(clone_work_dir)"
  cd "$WORK_REPO_DIR"
  apply_working_state
  export PATH="$WORK_REPO_DIR/bin:$PATH"

  . scripts/pipeline_lib.sh

  if [[ "$PIPELINE" != "dev" ]]; then
    LAST_DEPLOY_COMMIT="$(setup_deploy_test_case "$test_case")"
    DEPLOY_DIR="var/deploy"
  fi

  composer install "${COMPOSER_INSTALL_ARGS[@]}"
  ci_build_id="$(write_ci_build_id "$test_case")"

  run_pipeline
  run_preview_checks "$test_case" "$ci_build_id"
}

setup_deploy_test_case() {
  local test_case="$1"
  case "$test_case" in
    test-admin-deploy)          printf '\n' ;;
    test-push-deploy)           setup_push_deploy_test ;;
    test-composer-lock-changed) setup_composer_lock_test ;;
    *)  echo "bin/ci: unbekannter Testfall: $test_case" >&2; exit 1 ;;
  esac
}

run_preview_checks() {
  local test_case="$1" ci_build_id="$2"
  if [[ "$PIPELINE" != "preview" ]]; then
    return
  fi
  trigger_preview_admin_run
  run_preview_test_case_checks "$test_case" "$ci_build_id"
  http_smoke_checks "preview-web" "80"
  run_smtp_smoke
  run_contact_smoke
}

trigger_preview_admin_run() {
  if [[ -z "${LAST_DEPLOY_COMMIT:-}" ]]; then
    return
  fi
  trigger_admin_run "preview-web" "80"
}

run_preview_test_case_checks() {
  local test_case="$1" ci_build_id="$2"
  if [[ "$test_case" == "test-push-deploy" ]]; then
    smoke_http_page_contains "preview-web" "80" "/ci-diff-test.html" "ci-diff-test"
    check_vendor_not_uploaded "$ci_build_id"
  fi
  if [[ "$test_case" == "test-composer-lock-changed" ]]; then
    check_vendor_uploaded "$ci_build_id"
  fi
  return 0
}

run_smtp_smoke() {
  cli python "$PIPELINE" --phases runtime tests/ci/smtp-smoke.py
}

run_contact_smoke() {
  . tests/ci/contact-smoke.sh
  contact_smoke
}

test_no_diff_deploy() {
  local last_deploy_commit="$1"
  git diff --quiet "$last_deploy_commit" HEAD \
    || { echo "[no-diff-check] Deploy-Skip bei leerem Diff fehlgeschlagen" >&2; return 1; }
}

setup_push_deploy_test() {
  local last_deploy_commit
  last_deploy_commit="$(git rev-parse HEAD)"
  test_no_diff_deploy "$last_deploy_commit"
  printf '<!-- ci-diff-test -->\n' > public/ci-diff-test.html
  git add public/ci-diff-test.html
  git -c user.name="CI Test" -c user.email="ci@test.invalid" \
    commit -m "test: diff-deploy ci-test" >&2
  printf '%s\n' "$last_deploy_commit"
}

setup_composer_lock_test() {
  local last_deploy_commit
  last_deploy_commit="$(git rev-parse HEAD)"
  printf '\n' >> composer.lock
  git add composer.lock
  git -c user.name="CI Test" -c user.email="ci@test.invalid" \
    commit -m "test: diff-deploy composer-lock-changed ci-test" >&2
  printf '%s\n' "$last_deploy_commit"
}

write_ci_build_id() {
  local test_case="$1" id
  case "$test_case" in
  test-push-deploy|test-composer-lock-changed)
    id="$(git rev-parse HEAD)"
    printf '%s' "$id" | tee vendor/.ci-build-id
    ;;
  esac
}

trigger_admin_run() {
  local host="$1" port="$2" result
  result="$(
    curl --fail --silent --show-error \
      "http://${host}:${port}/admin/run"
  )"
  echo "[admin-trigger] ${result}"
}

sftp_read_vendor_build_id() {
  cli python "$PIPELINE" --phases deploy scripts/sftp-read-vendor-build-id.py
}

check_vendor_not_uploaded() {
  local ci_build_id="$1" server_id
  server_id="$(sftp_read_vendor_build_id)"
  if [[ "$server_id" == "$ci_build_id" ]]; then
    echo "[vendor-check] vendor/ fälschlicherweise hochgeladen: build_id=$ci_build_id" >&2
    return 1
  fi
}

check_vendor_uploaded() {
  local ci_build_id="$1" server_id
  server_id="$(sftp_read_vendor_build_id)"
  if [[ "$server_id" != "$ci_build_id" ]]; then
    echo "[vendor-check] vendor/ nicht hochgeladen: erwartet=$ci_build_id, server=$server_id" >&2
    return 1
  fi
}

clone_work_dir() {
  local work_dir
  work_dir="$(mktemp -d "$CI_WORK_BASE/ci-XXXXXX")"
  git clone --local --no-hardlinks "$SOURCE_REPO_DIR" "$work_dir"
  echo "$work_dir"
}

apply_working_state() {
  apply_tracked_working_diff
  copy_untracked_working_files
}

apply_tracked_working_diff() {
  local diff
  diff="$(git -C "$SOURCE_REPO_DIR" -c safe.directory="$SOURCE_REPO_DIR" diff --binary HEAD)"
  if [[ -z "$diff" ]]; then
    return 0
  fi
  echo "$diff" | git apply --whitespace=nowarn
}

copy_untracked_working_files() {
  git -C "$SOURCE_REPO_DIR" -c safe.directory="$SOURCE_REPO_DIR" ls-files --others --exclude-standard \
    | while IFS= read -r f; do
        copy_untracked_working_file "$f"
      done
}

copy_untracked_working_file() {
  local file="$1"
  mkdir -p "$(dirname "$file")"
  cp "$SOURCE_REPO_DIR/$file" "$file"
}

main "$@"
