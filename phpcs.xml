<?xml version="1.0"?>
<ruleset name="LebenslaufVorlageCodingStandard">
    <description>Projektstandard für PHP-Code.</description>

    <file>src</file>
    <file>tests/php</file>
    <file>public</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>var/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>

    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="72"/>
            <property name="absoluteLineLimit" value="72"/>
            <property name="ignoreComments" value="false"/>
        </properties>
    </rule>

    <rule ref="Generic.Metrics.NestingLevel">
        <properties>
            <property name="nestingLevel" value="2"/>
            <property name="absoluteNestingLevel" value="3"/>
        </properties>
    </rule>

    <rule ref="Generic.Metrics.CyclomaticComplexity">
        <properties>
            <property name="complexity" value="8"/>
            <property name="absoluteComplexity" value="12"/>
        </properties>
    </rule>
</ruleset>
