{% extends 'base.html.twig' %}

{% block content %}
  {% import 'components/site/lib.html.twig' as ui %}

  <article class="markdown-body">
    {{ ui.page_title(post.titel) }}
    <p class="content-meta">{{ post.datum }}</p>
    {{ post.inhalt_html }}
    {% if post.tags is defined and post.tags %}
      <p class="content-meta">
        {% for tag in post.tags %}{{ tag }}{% if not loop.last %}, {% endif %}{% endfor %}
      </p>
    {% endif %}
    <p>{{ ui.link(path('/blog?lang=' ~ lang), '← Alle Posts') }}</p>
  </article>
{% endblock %}
