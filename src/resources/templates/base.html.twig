<!DOCTYPE html>
<html lang="{{ lang|default('de') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="{{ path('/css/site.css') }}">
</head>
<body>
  <div class="site-shell">
    {{ site_header|raw }}

    <main class="site-main">
      {% block content %}{% endblock %}
    </main>

    {{ site_footer|raw }}
  </div>
</body>
</html>
