{% extends 'base.html.twig' %}

{% block content %}
  {% import 'components/site/lib.html.twig' as ui %}

  <article class="markdown-body">
    {{ ui.page_title('Blog') }}

    {% if intro_html %}{{ intro_html }}{% endif %}

    {% if posts is empty %}
      <p class="content-meta">Noch keine Beiträge vorhanden.</p>
    {% else %}
      <ul class="blog-list">
        {% for post in posts %}
          <li>
            <p><strong>{{ ui.link(path('/blog/' ~ post.slug ~ '?lang=' ~ lang), post.titel) }}</strong></p>
            <p class="content-meta">{{ post.datum }}</p>
            <p><em>{{ post.zusammenfassung }}</em></p>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </article>
{% endblock %}
