<footer class="{% if cv_mode|default(false) %}cv-footer{% else %}markdown-body site-footer{% endif %}">
  {% if privacy_note %}
    <div class="site-footer-note">{{ privacy_note }}</div>
  {% endif %}
  <div class="footer-meta">
    <div>{{ "now"|date("d.m.Y") }} {{ attribution }}</div>
    {% if built_with %}
      <div>{{ built_with }}</div>
    {% endif %}
  </div>
</footer>
