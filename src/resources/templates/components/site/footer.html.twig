<footer>
  {% if privacy_note %}
    <div>{{ privacy_note }}</div>
  {% endif %}
  <div class="footer-meta">
    <span>{{ "now"|date("d.m.Y") }} {{ attribution }}</span>
    {% if built_with %}
      <span>{{ built_with }}</span>
    {% endif %}
    <span><a href="{{ source_url }}">{{ source_url }}</a></span>
  </div>
</footer>
