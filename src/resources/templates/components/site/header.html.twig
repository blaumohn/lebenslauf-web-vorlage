<header class="site" aria-label="Seitennavigation">
  <a href="{{ path('/') }}" class="site-name">{{ site_name }}</a>
  <nav class="site-nav" aria-label="Navigation">
    {% for item in nav_items %}
      <a href="{{ path(item.href) }}">{{ item.label }}</a>
    {% endfor %}
  </nav>
  <nav class="lang-nav" aria-label="Sprache">
    {% for item in lang_items %}
      {% if item.current %}
        <span class="lang-item lang-current">{{ item.code }}</span>
      {% else %}
        <a class="lang-item" href="{{ item.href }}">{{ item.code }}</a>
      {% endif %}
    {% endfor %}
  </nav>
</header>
