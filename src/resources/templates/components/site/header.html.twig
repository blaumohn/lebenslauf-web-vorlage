<header class="site-header" aria-label="Seitennavigation">
  <a href="{{ path('/') }}" class="site-name">{{ site_name }}</a>
  <nav class="markdown-body site-nav" aria-label="Hauptnavigation">
    <ul>
      {% for item in nav_items %}
        <li><a href="{{ path(item.href) }}">{{ item.label }}</a></li>
      {% endfor %}
    </ul>
  </nav>
  <nav class="language-nav" aria-label="Sprache">
    {% for item in lang_items %}
      {% if item.current %}
        <span class="language-item" aria-current="true">{{ item.code }}</span>
      {% else %}
        <a class="language-item" href="{{ item.href }}">{{ item.code }}</a>
      {% endif %}
    {% endfor %}
  </nav>
</header>
