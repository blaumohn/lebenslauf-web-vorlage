{% macro view(cv, etiketten, is_private, name, cv_footer) %}
  {% import 'components/cv/lib.html.twig' as ui %}
  {% import 'components/cv/page.html.twig' as page %}
  {% import 'components/cv/sections.html.twig' as section %}
  <header class="cv-header" aria-label="{{ name }}">
    <div class="header-main">
      {{ ui.name_block(name, cv.kopfdaten.bereich) }}
    </div>
    {% if is_private %}
      <div class="header-aside">
        {{ page.contact_private(cv) }}
      </div>
    {% endif %}
  </header>

  <div class="cv-body">
    <div class="cv-aside-col">
      {{ section.skills(
        etiketten.faehigkeiten.value,
        cv.faehigkeiten,
        'section-skills'
      ) }}

      {{ section.languages(
        etiketten.sprachen.value,
        cv.sprachen,
        'section-languages'
      ) }}

      {{ section.interests(
        etiketten.interessen.value,
        cv.interessen,
        'section-interests'
      ) }}
    </div>

    <section class="cv-main-col">
      {{ section.motivation(
        etiketten.motivation.value,
        cv.motivation,
        'section-motivation'
      ) }}

      {{ section.entries(
        etiketten.berufserfahrung.value,
        cv.berufserfahrung,
        'section-experience'
      ) }}

      {% if cv.opensource is defined %}
        {{ section.entries(
          etiketten.opensource.value,
          cv.opensource,
          'section-opensource'
        ) }}
      {% endif %}

      {% if cv.vortraege is defined %}
        {{ section.talks(
          etiketten.vortraege.value,
          cv.vortraege,
          'section-talks'
        ) }}
      {% endif %}

      {{ section.education(
        etiketten.ausbildung.value,
        cv.ausbildung,
        'section-education'
      ) }}
    </section>
  </div>

  {% if cv_footer %}
    {{ cv_footer|raw }}
  {% endif %}
{% endmacro %}
