{% macro view(cv, kontaktdaten, etiketten, is_private, name, cv_footer) %}
  {% import 'components/cv/lib.html.twig' as ui %}
  {% import 'components/cv/page.html.twig' as page %}
  {% import 'components/cv/sections.html.twig' as section %}
  <header class="cv-header" aria-label="{{ name }}">
    <div class="header-main">
      {{ ui.name_block(name, cv.titel) }}
    </div>
    {% if is_private %}
      <div class="header-aside">
        {{ page.contact_private(kontaktdaten) }}
      </div>
    {% endif %}
  </header>

  <div class="cv-body">
    <div class="cv-aside-col">
      {{ section.skills(
        etiketten.kenntnisse.value,
        cv.kenntnisse,
        'section-skills',
        cv.zeige_kenntnisse_label|default(false)
      ) }}

      {{ section.languages(
        etiketten.sprachen.value,
        cv.sprachen,
        'section-languages'
      ) }}

      {{ section.interests(
        etiketten.interessen.value,
        cv.interessen,
        'section-interests'
      ) }}
    </div>

    <section class="cv-main-col">
      {{ section.motivation(
        etiketten.motivation.value,
        cv.motivation,
        'section-motivation'
      ) }}

      {% set experience_section %}
        {{ section.experience(
          etiketten.berufserfahrung.value,
          cv.berufserfahrung,
          'section-experience'
        ) }}
      {% endset %}

      {% set opensource_section %}
        {% if cv.opensource is defined %}
          {{ section.entries(
            etiketten.opensource.value,
            cv.opensource,
            'section-opensource'
          ) }}
        {% endif %}
      {% endset %}

      {% set main_sections = cv.opensource_first
        ? [opensource_section, experience_section]
        : [experience_section, opensource_section]
      %}
      {{ main_sections|join|raw }}

      {% if cv.vortraege is defined %}
        {{ section.talks(
          etiketten.vortraege.value,
          cv.vortraege,
          'section-talks'
        ) }}
      {% endif %}

      {{ section.education(
        etiketten.ausbildung.value,
        cv.ausbildung,
        'section-education'
      ) }}
    </section>
  </div>

  {% if cv_footer %}
    {{ cv_footer|raw }}
  {% endif %}
{% endmacro %}
