{% macro contact_private(kontaktdaten) %}
  <div class="contact">
    <div>{{ kontaktdaten.telefon }} | {{ kontaktdaten.ort }}</div>
    <div>{{ kontaktdaten.email }}</div>
    {% if kontaktdaten.linkedin is defined %}
      <div>{{ kontaktdaten.linkedin }}</div>
    {% endif %}
  </div>
{% endmacro %}
