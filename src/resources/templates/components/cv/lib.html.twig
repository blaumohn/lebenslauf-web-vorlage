{% macro section_title(titel, show_line = true) %}
  <div class="section-title-block">
    {% if show_line %}
      <div class="section-line"></div>
    {% endif %}
    <h2 class="section-title">{{ titel }}</h2>
  </div>
{% endmacro %}

{% macro tag_list(tags) %}
  <div class="tag-list">
    {% for tag in tags %}
      <span class="tag">{{ tag }}</span>
    {% endfor %}
  </div>
{% endmacro %}

{% macro dot_scale(wert, max) %}
  {% set dots = '' %}
  {% for i in 1..max %}
    {% set dots = dots ~ (i <= wert ? '&#9679;' : '&#9675;') %}
  {% endfor %}
  <div class="dot-scale" role="img" aria-label="{{ wert }}/{{ max }}">{{ dots|raw }}</div>
{% endmacro %}

{% macro skill_group(gruppe) %}
  <div class="skill-group">
    {% if gruppe.gruppe_label is not empty %}
      <p class="skill-level">{{ gruppe.gruppe_label }}</p>
    {% endif %}
    {% if gruppe.show_wert %}
      {% if gruppe.max_wert <= 10 %}
        {{ _self.dot_scale(gruppe.wert, gruppe.max_wert) }}
      {% else %}
        <div class="skill-value">{{ gruppe.wert }} / {{ gruppe.max_wert }}</div>
      {% endif %}
    {% endif %}
    {% if gruppe.show_tags %}
      {{ _self.tag_list(gruppe.tags) }}
    {% endif %}
  </div>
{% endmacro %}

{% macro name_block(name, bereich) %}
  <div class="name">
    <h1 class="name-title">{{ name }}</h1>
    <p class="name-role">{{ bereich }}</p>
  </div>
{% endmacro %}
