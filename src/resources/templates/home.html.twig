{% extends 'base.html.twig' %}

{% block content %}
  {% import 'components/site/lib.html.twig' as ui %}

  <article class="markdown-body">
    {{ ui.page_title(titel) }}
    {{ beschreibung_html }}

    <ul>
      <li>{{ ui.link(path('/cv'), link_lebenslauf) }}</li>
      <li>{{ ui.link(path('/contact'), link_kontakt) }}</li>
    </ul>
    {% if public_cv_message is defined %}<p class="content-meta">{{ public_cv_message }}</p>{% endif %}
  </article>
{% endblock %}
