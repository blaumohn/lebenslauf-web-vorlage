{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "heading", "description", "link"],
  "properties": {
    "title":       { "$ref": "#/definitions/intlString" },
    "heading":     { "$ref": "#/definitions/intlString" },
    "description": { "$ref": "#/definitions/intlString" },
    "link":        { "$ref": "#/definitions/intlString" }
  },
  "definitions": {
    "intlString": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
