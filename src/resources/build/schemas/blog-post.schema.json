{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "datum", "status", "titel", "zusammenfassung", "inhalt"],
  "properties": {
    "slug":           { "type": "string", "minLength": 1 },
    "datum":          { "type": "string", "minLength": 1 },
    "status":         { "type": "string", "enum": ["published", "draft"] },
    "titel":          { "$ref": "common.schema.json#/definitions/intlString" },
    "zusammenfassung":{ "$ref": "common.schema.json#/definitions/intlString" },
    "inhalt":         { "$ref": "common.schema.json#/definitions/intlMarkdown" },
    "tags":           { "type": "array", "items": { "type": "string" } }
  }
}
