{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["titel", "beschreibung", "link_lebenslauf", "link_kontakt"],
  "properties": {
    "titel":           { "$ref": "#/definitions/intlString" },
    "beschreibung":    { "$ref": "#/definitions/intlString" },
    "link_lebenslauf": { "$ref": "#/definitions/intlString" },
    "link_kontakt":    { "$ref": "#/definitions/intlString" }
  },
  "definitions": {
    "intlString": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      ]
    }
  }
}
