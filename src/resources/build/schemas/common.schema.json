{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "intlString": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "anyOf": [
              { "const": "default" },
              { "pattern": "^[a-z]{2}(-[a-z]{2})?$" }
            ]
          },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "intlMarkdown": {
      "description": "Markdown mit optionalen Twig-Ausdrücken; wird ausschließlich beim Build gerendert.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      ]
    }
  }
}
