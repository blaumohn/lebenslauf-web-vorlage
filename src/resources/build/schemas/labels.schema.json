{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["cv", "contact"],
  "properties": {
    "cv":      { "$ref": "#/definitions/labelGroup" },
    "contact": { "$ref": "#/definitions/labelGroup" }
  },
  "definitions": {
    "labelGroup": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value":    { "$ref": "common.schema.json#/definitions/intlString" },
        "childLabels": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/labelGroup" }
        }
      }
    }
  }
}
