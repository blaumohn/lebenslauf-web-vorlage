{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kopfdaten",
    "motivation",
    "faehigkeiten",
    "berufserfahrung",
    "sprachen",
    "ausbildung",
    "interessen"
  ],
  "properties": {
    "oeffentlich": { "type": "boolean" },
    "kopfdaten": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bereich", "ort", "email", "telefon"],
      "properties": {
        "name": { "type": "string" },
        "bereich": { "$ref": "common.schema.json#/definitions/intlString" },
        "ort": { "$ref": "common.schema.json#/definitions/intlString" },
        "email": { "type": "string" },
        "telefon": { "type": "string" },
        "linkedin": { "type": "string" }
      }
    },
    "motivation": { "$ref": "common.schema.json#/definitions/intlString" },
    "faehigkeiten": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stufe", "wert", "technologien"],
        "properties": {
          "stufe": { "$ref": "common.schema.json#/definitions/intlString" },
          "wert": { "type": "number" },
          "technologien": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/definitions/intlString" }
          }
        }
      }
    },
    "berufserfahrung": {
      "type": "array",
      "items": { "$ref": "#/definitions/unternehmen" }
    },
    "opensource": {
      "type": "array",
      "items": { "$ref": "#/definitions/eintragProjekt" }
    },
    "sprachen": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sprache", "stufe"],
        "properties": {
          "sprache": { "$ref": "common.schema.json#/definitions/intlString" },
          "stufe": { "$ref": "common.schema.json#/definitions/intlString" }
        }
      }
    },
    "ausbildung": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uni"],
        "properties": {
          "uni": { "$ref": "common.schema.json#/definitions/intlString" },
          "grad": { "$ref": "common.schema.json#/definitions/intlString" },
          "beschreibung": { "$ref": "common.schema.json#/definitions/intlString" }
        },
        "anyOf": [
          { "required": ["grad"] },
          { "required": ["beschreibung"] }
        ]
      }
    },
    "vortraege": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titel", "beschreibung", "datum"],
        "properties": {
          "titel": { "type": "string" },
          "beschreibung": { "$ref": "common.schema.json#/definitions/intlString" },
          "datum": { "$ref": "common.schema.json#/definitions/intlString" }
        }
      }
    },
    "interessen": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/definitions/intlString" }
    }
  },
  "definitions": {
    "eintragPunkt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tags", "text"],
      "properties": {
        "tags": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/definitions/intlString" }
        },
        "text": { "$ref": "common.schema.json#/definitions/intlString" }
      }
    },
    "eintrag": {
      "type": "object",
      "required": ["titel", "zeitraum", "punkte"],
      "properties": {
        "titel": { "$ref": "common.schema.json#/definitions/intlString" },
        "zeitraum": { "$ref": "common.schema.json#/definitions/intlString" },
        "punkte": {
          "type": "array",
          "items": { "$ref": "#/definitions/eintragPunkt" }
        }
      }
    },
    "stelle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titel", "zeitraum", "ort", "punkte"],
      "properties": {
        "titel": { "$ref": "common.schema.json#/definitions/intlString" },
        "zeitraum": { "$ref": "common.schema.json#/definitions/intlString" },
        "ort": { "$ref": "common.schema.json#/definitions/intlString" },
        "punkte": {
          "type": "array",
          "items": { "$ref": "#/definitions/eintragPunkt" }
        }
      }
    },
    "unternehmen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unternehmen", "stellen"],
      "properties": {
        "unternehmen": { "type": "string" },
        "stellen": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/stelle" }
        }
      }
    },
    "eintragProjekt": {
      "allOf": [
        { "$ref": "#/definitions/eintrag" },
        {
          "type": "object",
          "required": ["projekt"],
          "properties": {
            "projekt": { "type": "string" },
            "url": { "type": "string", "format": "uri" }
          }
        }
      ]
    }
  }
}
