{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["name_kurz", "footer"],
  "properties": {
    "name_kurz": { "type": "string", "minLength": 1 },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url"],
      "properties": {
        "privacy_note": { "$ref": "#/definitions/intlString" },
        "built_with":   { "$ref": "#/definitions/intlString" },
        "source_url":   { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "intlString": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      ]
    }
  }
}
