{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["name_kurz", "footer"],
  "properties": {
    "name_kurz": { "type": "string", "minLength": 1 },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url"],
      "properties": {
        "privacy_note": { "$ref": "common.schema.json#/definitions/intlString" },
        "built_with":   { "$ref": "common.schema.json#/definitions/intlString" },
        "source_url":   { "type": "string", "minLength": 1 }
      }
    }
  }
}
